<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tambah Menu Baru - KitaPOS</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <!-- Remix Icon -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
  <link rel="manifest" href="/manifest.json">
</head>
<body class="bg-gray-50 font-sans antialiased pb-12">

  <!-- TOP BAR / HEADER -->
  <header class="bg-white shadow-xs sticky top-0 z-10 px-4 py-3">
    <div class="max-w-xl mx-auto flex items-center gap-3">
      <a href="index.html" class="text-gray-500 hover:text-gray-800 p-1 rounded-lg hover:bg-gray-100 transition-colors">
        <i class="ri-arrow-left-line text-xl"></i>
      </a>
      <div>
        <h1 class="text-lg font-bold text-gray-800">Tambah Menu Baru</h1>
        <p class="text-xs text-gray-500">Masukkan detail produk dagangan Anda</p>
      </div>
    </div>
  </header>

  <!-- FORMULIR INPUT -->
  <main class="max-w-xl mx-auto px-4 mt-6">
    <form id="form-tambah-menu" onsubmit="simpanMenuBaru(event)" class="bg-white p-6 rounded-2xl border border-gray-100 shadow-xs space-y-5">
      
      <!-- UPLOAD & PRATINJAU GAMBAR -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Foto Produk</label>
        <div class="flex flex-col items-center justify-center border-2 border-dashed border-gray-200 rounded-2xl p-4 bg-gray-50 hover:bg-gray-100/50 transition-colors relative group min-h-[160px]">
          
          <!-- Input File Tersembunyi -->
          <input type="file" id="input-gambar" accept="image/*" onchange="prosesGambar(event)" required
                 class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
          
          <!-- Placeholder saat belum ada gambar -->
          <div id="placeholder-gambar" class="text-center space-y-1">
            <i class="ri-image-add-line text-3xl text-gray-400 group-hover:text-blue-500 transition-colors"></i>
            <p class="text-xs font-medium text-gray-500">Klik atau seret foto ke sini</p>
            <p class="text-[10px] text-gray-400">Rekomendasi format WebP / PNG (Maks. 2MB)</p>
          </div>

          <!-- Element Pratinjau Gambar -->
          <img id="pratinjau-gambar" src="#" alt="Pratinjau" class="hidden w-full h-40 object-cover rounded-xl shadow-xs">
          
          <!-- Tombol Hapus Gambar (Muncul saat ada gambar) -->
          <button type="button" id="btn-hapus-gambar" onclick="hapusGambar(event)" 
                  class="hidden absolute top-2 right-2 bg-red-500 hover:bg-red-600 text-white p-1.5 rounded-full shadow-md z-20 transition-transform active:scale-90">
            <i class="ri-delete-bin-line text-sm"></i>
          </button>
        </div>
      </div>

      <!-- NAMA PRODUK -->
      <div>
        <label for="nama-produk" class="block text-sm font-semibold text-gray-700 mb-1">Nama Produk <span class="text-red-500">*</span></label>
        <input type="text" id="nama-produk" required placeholder="Contoh: Es Kopi Susu Aren"
               class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      </div>

      <!-- KATEGORI & STOK (GRID 2 KOLOM) -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="kategori-produk" class="block text-sm font-semibold text-gray-700 mb-1">Kategori <span class="text-red-500">*</span></label>
          <select id="kategori-produk" required
                  class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm bg-white focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
            <option value="" disabled selected>Pilih Kategori</option>
            <option value="makanan">Makanan</option>
            <option value="minuman">Minuman</option>
            <option value="cemilan">Cemilan</option>
          </select>
        </div>
        <div>
          <label for="stok-produk" class="block text-sm font-semibold text-gray-700 mb-1">Stok Awal <span class="text-red-500">*</span></label>
          <input type="number" id="stok-produk" required min="0" placeholder="0"
                 class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
        </div>
      </div>

      <!-- HARGA JUAL -->
      <div>
        <label for="harga-produk" class="block text-sm font-semibold text-gray-700 mb-1">Harga Jual (Rp) <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-semibold text-gray-400 pointer-events-none">Rp</span>
          <input type="number" id="harga-produk" required min="0" placeholder="0"
                 class="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl text-sm font-bold text-gray-800 focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
        </div>
      </div>

      <!-- TOMBOL AKSI -->
      <div class="pt-2 flex gap-3">
        <a href="index.html" class="w-1/3 bg-gray-100 hover:bg-gray-200 text-gray-600 font-semibold py-2.5 rounded-xl text-sm text-center transition-colors">
          Batal
        </a>
        <button type="submit" class="w-2/3 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-sm shadow-md transition-all active:scale-98 flex items-center justify-center gap-2">
          <i class="ri-save-line"></i> Simpan Produk
        </button>
      </div>

    </form>
  </main>

  <!-- LOGIKA JAVASCRIPT -->
  <script>
    // Variabel global untuk menyimpan string Base64 gambar
    let stringBase64Gambar = "";

    // 1. Fungsi Memproses & Mengonversi Gambar ke Base64 secara Real-time
    function prosesGambar(event) {
      const file = event.target.files[0];
      if (!file) return;

      // Batasi ukuran file maksimal 2MB
      if (file.size > 2 * 1024 * 1024) {
        alert("Ukuran file terlalu besar! Maksimal adalah 2MB.");
        event.target.value = "";
        return;
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        stringBase64Gambar = e.target.result;

        // Tampilkan gambar pada elemen pratinjau
        const imgElement = document.getElementById('pratinjau-gambar');
        imgElement.src = stringBase64Gambar;
        imgElement.classList.remove('hidden');

        // Sembunyikan placeholder dan tampilkan tombol hapus
        document.getElementById('placeholder-gambar').classList.add('hidden');
        document.getElementById('btn-hapus-gambar').classList.remove('hidden');
      }
      reader.readAsDataURL(file); // Mengubah file gambar ke data URL Base64
    }

    // 2. Fungsi Menghapus Gambar yang Telah Dipilih
    function hapusGambar(event) {
      event.preventDefault(); // Cegah klik tembus ke input file
      stringBase64Gambar = "";
      
      // Reset input dan tampilan
      document.getElementById('input-gambar').value = "";
      document.getElementById('pratinjau-gambar').classList.add('hidden');
      document.getElementById('pratinjau-gambar').src = "#";
      document.getElementById('placeholder-gambar').classList.remove('hidden');
      document.getElementById('btn-hapus-gambar').classList.add('hidden');
    }

    // 3. Fungsi Menangani Submit Formulir
    function simpanMenuBaru(event) {
      event.preventDefault(); // Cegah reload halaman

      // Kumpulkan data dari input form
      const produkBaru = {
        id: Date.now(), // Generate ID unik menggunakan timestamp sementara
        nama: document.getElementById('nama-produk').value,
        kategori: document.getElementById('kategori-produk').value,
        stok: parseInt(document.getElementById('stok-produk').value),
        harga: parseFloat(document.getElementById('harga-produk').value),
        gambar: stringBase64Gambar // Menyimpan string gambar lokal (Base64)
      };

      console.log("Data Produk Baru Siap Disimpan:", produkBaru);

      // --- INTEGRASI INDEXEDDB / DEXIE.JS (Tahap Awal) ---
      // Anda tinggal memanggil fungsi database lokal Anda di sini:
      // db.produk.add(produkBaru);
      // ----------------------------------------------------

      alert(`🎉 Produk "${produkBaru.nama}" berhasil disimpan secara lokal!`);
      
      // Reset isi form dan kembali ke halaman menu utama
      document.getElementById('form-tambah-menu').reset();
      window.location.href = "index.html"; 
    }
  </script>
</body>
</html>